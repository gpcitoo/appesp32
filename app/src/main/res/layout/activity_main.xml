<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F4F4F9">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Traductor USB Offline (Vosk)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔌 Conectar ESP32 por USB"
        android:backgroundTint="#28A745"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Botón de Micrófono Grande y Redondo -->
    <Button
        android:id="@+id/btnHablar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/ic_mic_background"
        android:drawableTop="@android:drawable/ic_btn_speak_now"
        android:gravity="center"
        android:contentDescription="Escuchar"
        android:layout_gravity="center_horizontal"
        android:layout_margin="16dp" />

    <!-- Layout del Espectro con barras simuladas -->
    <LinearLayout
        android:id="@+id/layoutEspectro"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="#11000000">

        <!-- Barras que simularán el movimiento de audio -->
        <View android:id="@+id/bar1" android:layout_width="6dp" android:layout_height="20dp" android:background="#007BFF" android:layout_margin="3dp"/>
        <View android:id="@+id/bar2" android:layout_width="6dp" android:layout_height="40dp" android:background="#007BFF" android:layout_margin="3dp"/>
        <View android:id="@+id/bar3" android:layout_width="6dp" android:layout_height="15dp" android:background="#007BFF" android:layout_margin="3dp"/>
        <View android:id="@+id/bar4" android:layout_width="6dp" android:layout_height="50dp" android:background="#007BFF" android:layout_margin="3dp"/>
        <View android:id="@+id/bar5" android:layout_width="6dp" android:layout_height="25dp" android:background="#007BFF" android:layout_margin="3dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progressBarOnnx"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="visible"
        android:layout_marginVertical="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voz Transcrita (Offline):"
            android:textSize="11sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/txtOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="---"
            android:textSize="16sp"
            android:textColor="#007BFF"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Respuesta / Estado ESP32:"
            android:textSize="11sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/txtTraducido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="---"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111111"/>
    </LinearLayout>

</LinearLayout>